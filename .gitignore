# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Env — never commit real secrets; the example is the exception below
.env
.env.*
!.env.example

# Agent skills installed via the `skills` CLI — tracked by skills-lock.json only.
# Restore after clone with: bunx skills experimental_install
.agents/
.claude/skills/

# Logs / OS / editor cruft
*.log
.DS_Store
.idea/
.vscode/

# Ephemeral session handover (resume pointer; regenerated each wrap-up)
docs/handover.md

# Playwright e2e artefacts
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
.vercel
.env*

# Vercel serverless bundle (generated by buildCommand from api-src/)
/api/*.js

# Playwright JSON report (written by the criterion-3 guard step in CI).
playwright-report.json

# Agent worktrees (isolated parallel sessions; contents never belong to a commit).
.claude/worktrees/
