# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Env — never commit real secrets; the example is the exception below
.env
.env.*
!.env.example

# Agent skills installed via the `skills` CLI — tracked by skills-lock.json only.
# Restore after clone with: bunx skills experimental_install
.agents/
.claude/skills/

# Logs / OS / editor cruft
*.log
.DS_Store
.idea/
.vscode/

# Ephemeral session handover (resume pointer; regenerated each wrap-up)
docs/handover.md

# Playwright e2e artefacts
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
.vercel
.env*

# Vercel serverless bundle (generated by buildCommand from api-src/)
/api/*.js

# Playwright JSON report (written by the criterion-3 guard step in CI).
playwright-report.json

# Agent worktrees (isolated parallel sessions; contents never belong to a commit).
.claude/worktrees/

# Python virtualenv for the RAGAS eval harness (uv rebuilds it from the lockfile).
evals/ragas/.venv/

# Python test cache.
.pytest_cache/

# Python bytecode.
__pycache__/
*.pyc

# Cached model replies for the eval harnesses (content-addressed, rebuildable).
evals/.cache/

# The judge cache. Re-grading must not re-pay for the same judgement, but the
# replies themselves are a local artefact, not source.
evals/ragas/.cache/

# Agent plan ledgers, briefs and review diffs. An inner .superpowers/sdd/.gitignore
# already ignores that subtree, but only that subtree: anything written to
# .superpowers/ directly was untracked AND unignored, one `git add -A` away from
# a public commit. Ignore the whole root. (Added 2026-09-23, pre-publication audit.)
.superpowers/
