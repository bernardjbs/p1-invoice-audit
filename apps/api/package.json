{
  "name": "@starter/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "bun run src/db/seed.ts && bun run scripts/generate-invoice-pdfs.ts",
    "worker": "bun run src/worker.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.11",
    "@langchain/pgvector": "^0.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "playwright": "^1.62.1"
  }
}
