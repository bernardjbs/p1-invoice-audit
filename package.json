{
  "name": "p1-invoice-audit",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . && bun run lint:citations",
    "lint:citations": "bash scripts/check-plan-citations.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:ops",
    "typecheck:ops": "tsc -p tsconfig.ops.json",
    "test": "bun run --filter '*' test",
    "test:integration": "bun run --filter '@starter/api' test:integration",
    "seed": "bun run --filter '@starter/api' seed",
    "build": "bun run --filter '*' build",
    "e2e": "playwright test",
    "e2e:stub": "AUDIT_ENGINE=stub playwright test --grep @swap"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.62.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.116.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vercel": "^59.10.0",
    "vitest": "^4.1.11"
  }
}
