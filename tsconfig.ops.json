{
  // Everything with no app of its own: the deploy bundle source, ops scripts, the
  // eval harness, and every TOOL CONFIG written in TypeScript.
  //
  // The config files are here because they were checked by nothing (proved
  // 2026-09-23 by putting a deliberate type error in each and watching the gate
  // still exit 0). A broken test or deploy config then fails at RUN time, inside
  // whichever CI job happens to load it, which reads as a broken suite rather
  // than a broken config. `apps/web/vite.config.ts` is the exception: it has had
  // its own tsconfig all along, but nothing ran it — the web `typecheck` script
  // now does.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./apps/api/node_modules/@types"]
  },
  "include": [
    "api-src/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "playwright.config.ts",
    "vitest.evals.config.ts",
    "apps/api/*.config.ts"
  ]
}
